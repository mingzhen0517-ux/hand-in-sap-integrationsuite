# SAP Cloud Integration tenant API host (do not include /api/v1)
SAP_CPI_BASE_URL=https://<tenant-host>

# oauth2 (recommended) or basic
SAP_AUTH_TYPE=oauth2

# OAuth2 client credentials
SAP_TOKEN_URL=https://<token-host>/oauth/token
SAP_CLIENT_ID=<client-id>
SAP_CLIENT_SECRET=<client-secret>

# Basic authentication fallback
SAP_USERNAME=<username>
SAP_PASSWORD=<password>

# Write tools are omitted unless this is exactly true
SAP_ALLOW_WRITE=false

SAP_REQUEST_TIMEOUT_MS=30000
SAP_MAX_BINARY_BYTES=26214400
